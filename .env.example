# ============================================
# SupportIntel - Environment Configuration
# ============================================
# Copy this file to .env and adjust as needed
# ============================================

# Application
APP_NAME=SupportIntel
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://frontend:80"]

# Database (MySQL)
DATABASE_URL=mysql+aiomysql://supportintel_user:supportintel_pass@localhost:3307/supportintel_db
DATABASE_SYNC_URL=mysql+pymysql://supportintel_user:supportintel_pass@localhost:3307/supportintel_db

# Passwords
MYSQL_ROOT_PASSWORD=root_password_secure_2024
MYSQL_PASSWORD=supportintel_pass
REDIS_PASSWORD=redis_pass_secure_2024
GRAFANA_PASSWORD=grafana_admin_2024

# Redis
REDIS_URL=redis://:redis_pass_secure_2024@localhost:6380/0

# JWT
JWT_SECRET_KEY=change-this-secret-key-in-production-min-32-chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=60

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=supportintel
MINIO_USE_SSL=false

# OpenAI / LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Vector Database
VECTOR_INDEX_PATH=/app/data/vectors/index.faiss
VECTOR_METADATA_PATH=/app/data/vectors/metadata.json

# Document Processing
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_DOCUMENT_SIZE_MB=10

# RAG
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# WebSocket
WS_HEARTBEAT_INTERVAL=30

